# Copy this file to .env.local for local development and set the same
# variables in the Vercel project's Environment Variables for production.

# Gmail SMTP — generate an App Password at
# https://myaccount.google.com/apppasswords (paste with the spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=TenderLab Website

# Where inquiry-notification emails are delivered.
INQUIRY_TO=info@tenderlab.co.uk

# Portal API (FastAPI on TenderLab's VPS) — used server-side by tenders, blogs
# and the inquiry relay. This value is required in Vercel and must be the
# externally reachable HTTPS API base. There is deliberately no code fallback.
PORTAL_API_URL=https://your-vps-api-host.example

# Public Portal/API base used only for enquiry storage and notification. Keep
# this separate when the read-only tender/blog feed and the admin API are
# exposed through different hosts. If omitted, PORTAL_API_URL is used.
PORTAL_INQUIRY_API_URL=https://admin.tenderlab.co.uk

# Admin portal URL — used in the email "Open in portal" button.
PORTAL_ADMIN_URL=https://admin.tenderlab.co.uk

# Comma-separated origins permitted to submit the inquiry form. Production
# origins are always included by code. Add the exact isolated Vercel preview
# origin while testing, then remove it after promotion.
INQUIRY_ALLOWED_ORIGINS=https://your-preview.vercel.app

# Shared secret sent only from the website relay to the VPS inquiry endpoint.
INQUIRY_RELAY_TOKEN=replace-with-a-long-random-secret

# Salt used to hash IP-derived rate-limit keys without retaining raw addresses.
INQUIRY_RATE_LIMIT_SALT=replace-with-a-separate-random-secret
